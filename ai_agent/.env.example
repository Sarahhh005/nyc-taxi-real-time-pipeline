# Copy this file to .env in the project root (same level as docker-compose.yml)
# and fill in your real OpenRouter API key before running `docker compose up`.

OPENAI_API_KEY=sk-or-v1-your-openrouter-key-here
OPENAI_API_BASE=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=NYC_TAXI
CLICKHOUSE_USER=spark_user
CLICKHOUSE_PASSWORD=spark_pass
