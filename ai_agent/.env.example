# Copy this file to .env in the project root (same level as docker-compose.yml)
# and fill in your real key before running `docker compose up`.

OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini

CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=NYC_TAXI
CLICKHOUSE_USER=spark_user
CLICKHOUSE_PASSWORD=spark_pass
